# Copia este ficheiro para .env.local e preenche na Etapa B.
# O Client ID OAuth é público por natureza (não é um segredo),
# mas mantém o .env.local fora do git na mesma.
VITE_GOOGLE_CLIENT_ID=

# D3.2 — Cancelamento de subscrições no YouTube.
# Por defeito (vazio ou "simulated") os cancelamentos são SIMULADOS: nada muda no YouTube.
# Só com "real" a app chama subscriptions.delete (exige o scope youtube.force-ssl na Google Cloud).
VITE_CUTSUB_CANCEL_MODE=
